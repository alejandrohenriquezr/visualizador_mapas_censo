{
  "version_estructura": "32.3.1",
  "servicios": [
    "frontend",
    "backend",
    "db",
    "llm",
    "cartography"
  ],
  "archivos_reproducibilidad": {
    "composicion": "docker-compose.yml",
    "variables_entorno": ".env.example",
    "dependencias": [
      "backend/requirements.txt",
      "cartography/requirements.txt"
    ],
    "migraciones": "database/migrations/",
    "validacion": "scripts/validate_repo.py"
  },
  "datos_externos_no_versionados": [
    {
      "tipo": "microdatos censales",
      "formato": "Parquet"
    },
    {
      "tipo": "cartografia censal",
      "formato": "FileGDB"
    }
  ],
  "estado_local_excluido": [
    ".env",
    "volumenes PostgreSQL y Ollama",
    "cache cartografica",
    "entornos virtuales",
    "copias y paquetes de parches historicos"
  ],
  "nota": "El repositorio versiona el codigo vigente, la configuracion de ejemplo, las dependencias, las migraciones y las pruebas. Los microdatos y la cartografia se provisionan localmente."
}
